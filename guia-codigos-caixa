<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guia Rápido de Códigos — Grupo Lagoa</title>
<style>
  :root{
    --navy:#0f2a4a; --navy2:#173a63; --cream:#fdf6e8; --purple:#6b2fa0;
    --green:#2f7d4f; --orange:#c0622a; --red:#b23a2f; --gray:#6b7280;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; font-family:'Segoe UI', Roboto, Arial, sans-serif; background:#eef1f5; color:#1a1a1a;
  }
  header{
    background:linear-gradient(135deg,var(--navy),var(--navy2)); color:#fff; padding:18px 16px 22px;
    position:sticky; top:0; z-index:50; box-shadow:0 4px 12px rgba(0,0,0,.15);
  }
  header h1{margin:0 0 4px; font-size:1.25rem;}
  header p{margin:0; font-size:.82rem; opacity:.85;}
  .search-wrap{margin-top:14px; position:relative;}
  #search{
    width:100%; padding:14px 44px 14px 16px; border-radius:12px; border:none; font-size:1.05rem;
    box-shadow:0 2px 8px rgba(0,0,0,.2);
  }
  .search-wrap::after{
    content:"🔍"; position:absolute; right:14px; top:50%; transform:translateY(-50%); font-size:1.1rem;
  }
  .count{font-size:.78rem; margin-top:6px; opacity:.9;}
  .tabs{display:flex; gap:8px; padding:12px 16px 0; overflow-x:auto; background:#eef1f5; position:sticky; top:118px; z-index:40;}
  .tab{
    padding:9px 16px; border-radius:20px; background:#fff; border:1px solid #d7dce3; font-size:.85rem; font-weight:600;
    cursor:pointer; white-space:nowrap; color:#333;
  }
  .tab.active{background:var(--navy); color:#fff; border-color:var(--navy);}
  main{padding:14px 16px 60px; max-width:900px; margin:0 auto;}
  .section{margin-top:22px;}
  .section-title{
    display:flex; align-items:center; gap:8px; font-size:1.05rem; font-weight:700; color:var(--navy);
    margin-bottom:8px; padding-bottom:6px; border-bottom:2px solid var(--navy);
  }
  .subgroup{margin-top:14px;}
  .subgroup-title{
    font-size:.85rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:#fff;
    background:var(--gray); display:inline-block; padding:4px 10px; border-radius:6px; margin-bottom:6px;
  }
  .subgroup-title.friskies{background:#1c4fa0;}
  .subgroup-title.smack{background:var(--orange);}
  .subgroup-title.dogchow{background:var(--green);}
  .subgroup-title.pedigree{background:var(--red);}
  .subgroup-title.vitamax{background:var(--purple);}
  .subgroup-title.whiskas{background:#0f766e;}
  table{width:100%; border-collapse:collapse; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,.06);}
  tr{border-bottom:1px solid #eee;}
  tr:last-child{border-bottom:none;}
  td{padding:10px 12px; font-size:.92rem; vertical-align:top;}
  td.code{
    font-family:'Courier New',monospace; font-weight:800; font-size:1.05rem; color:var(--navy); white-space:nowrap; width:90px;
  }
  td.desc{color:#222;}
  td.note{color:var(--gray); font-size:.78rem; display:block; margin-top:2px;}
  tr.hidden{display:none;}
  .refimg-wrap{margin:10px 0 16px; text-align:center;}
  .refimg-wrap img{max-width:100%; border-radius:10px; box-shadow:0 2px 10px rgba(0,0,0,.15); border:3px solid #fff;}
  .refimg-caption{font-size:.76rem; color:var(--gray); margin-top:4px;}
  .empty{text-align:center; padding:30px; color:var(--gray); font-size:.9rem;}
  .alert{
    background:#fff4e0; border-left:4px solid var(--orange); padding:10px 14px; border-radius:8px; font-size:.82rem;
    margin-bottom:14px; color:#5c3d0e;
  }
  footer{text-align:center; padding:20px; font-size:.75rem; color:var(--gray);}
  @media print{
    header,.tabs,#search-count{position:static;}
    .refimg-wrap img{max-width:60%;}
  }
</style>
</head>
<body>
<header>
  <h1>📋 Guia Rápido de Códigos — Rede Grupo Lagoa</h1>
  <p>Consulta rápida para operadores de caixa · Hortifruti · Petshop · Padaria</p>
  <div class="search-wrap">
    <input type="text" id="search" placeholder="Digite o código ou nome do produto...">
  </div>
  <div class="count" id="search-count"></div>
</header>

<div class="tabs" id="tabs">
  <div class="tab active" data-cat="all">Todos</div>
  <div class="tab" data-cat="Hortifruti">🥬 Hortifruti</div>
  <div class="tab" data-cat="Petshop">🐾 Petshop</div>
  <div class="tab" data-cat="Padaria">🥐 Padaria</div>
</div>

<main>

<div class="section" data-section="Hortifruti">
